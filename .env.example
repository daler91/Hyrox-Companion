# ==============================================================================
# fitai.coach - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or enable extra features.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core (Required)
# ------------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/fitaicoach"

# [OPTIONAL] Separate PostgreSQL/pgvector connection used by the RAG ingest +
# retrieval pipeline. When unset, the main DATABASE_URL is reused. Production
# splits this onto a Neon pgvector database; local dev can leave it blank.
# VECTOR_DATABASE_URL="postgresql://user:password@localhost:5432/fitaicoach_vector"

# [REQUIRED] 32+ character hex key for encrypting tokens at rest (AES-256-GCM)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# [OPTIONAL] Rotation key for ENCRYPTION_KEY (W6). To rotate without downtime:
# set this to a fresh key (leave ENCRYPTION_KEY in place). New ciphertext is
# tagged `v2` and encrypted with this key, while the old key keeps decrypting
# existing data. Then set ENCRYPTION_REENCRYPT_ON_BOOT=true and redeploy once to
# migrate stored credentials forward. Must differ from ENCRYPTION_KEY/CSRF_SECRET.
ENCRYPTION_KEY_V2=

# [OPTIONAL] When "true" (and ENCRYPTION_KEY_V2 is set), re-encrypt all stored
# Strava/Garmin credentials to the active key version on boot. Defaults "false".
ENCRYPTION_REENCRYPT_ON_BOOT=false

# [REQUIRED IN PRODUCTION] 32+ character hex key for CSRF protection.
# In production this MUST be set and MUST differ from ENCRYPTION_KEY — both
# invariants are enforced at startup. In development/test it may be omitted
# and the middleware generates a random per-process fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# [OPTIONAL] Comma-separated list of extra origins allowed by CORS. Localhost
# is always permitted. Only needed when the frontend runs on a different host
# from the API (e.g. a staging domain calling prod).
# ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"

# ------------------------------------------------------------------------------
# Authentication – Clerk (Optional, enables auth)
# ------------------------------------------------------------------------------
# Create a free project at https://dashboard.clerk.com

# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# AI - Text provider + Gemini embeddings/vision (Optional)
# ------------------------------------------------------------------------------
# Text AI defaults to Gemini for backwards compatibility. Set
# AI_TEXT_PROVIDER=anthropic or AI_TEXT_PROVIDER=openai-compatible to route
# chat, text parsing, coach suggestions, review notes, and plan generation
# through another provider. RAG embeddings and photo-to-workout parsing still
# use Gemini in this release.

# AI_TEXT_PROVIDER=gemini                 # gemini | anthropic | openai-compatible
# AI_TEXT_MODEL=                          # generic model override for non-Gemini providers
# AI_TEXT_FAST_MODEL=                     # optional fast parser model override
# AI_TEXT_REASONING_MODEL=                # optional coaching/planning model override
# AI_TEXT_REASONING_EFFORT=high           # none | low | medium | high
# AI_TEXT_API_KEY=                        # generic key fallback for anthropic/openai-compatible

# AI_TEXT_OPENAI_COMPATIBLE_PROFILE=openai # openai | xai | groq | together | openrouter | deepseek | custom
# AI_TEXT_BASE_URL=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ANTHROPIC_API_KEY=

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_SUGGESTIONS_MODEL=gemini-3.1-pro-preview
# GEMINI_VISION_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Strava Integration (Optional, enables activity sync)
# ------------------------------------------------------------------------------

# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_STATE_SECRET=           # CSRF protection; auto-generated if omitted
# APP_URL=http://localhost:5000  # Used for OAuth callback URLs

# ------------------------------------------------------------------------------
# Garmin Connect Integration
# ------------------------------------------------------------------------------
# Garmin has no public OAuth app flow — the integration authenticates as the
# end user with their own email+password against Garmin's SSO via the
# @flow-js/garmin-connect library. Credentials are stored encrypted in the
# garmin_connections table. There is NO server-side Garmin client/secret to
# configure here, and the feature is always available when a user enables it
# in Settings. See docs/integrations.md#garmin-connect-integration.

# ------------------------------------------------------------------------------
# Email – Resend (Optional, enables weekly summaries & reminders)
# ------------------------------------------------------------------------------

# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=fitai.coach <Timmy@fitai.coach>

# ------------------------------------------------------------------------------
# Cron Jobs (Optional)
# ------------------------------------------------------------------------------

# CRON_SECRET=                   # Auth token for /api/v1/cron/emails endpoint
# INTERNAL_ANALYTICS_SECRET=     # Auth token for /api/v1/analytics/internal/* endpoints

# ------------------------------------------------------------------------------
# Web Push / VAPID (Optional, enables PWA push notifications)
# ------------------------------------------------------------------------------
# Generate a keypair with:
#   npx web-push generate-vapid-keys
# When any of these are unset, /api/v1/push/* endpoints return 404
# PUSH_NOT_CONFIGURED and the client simply hides the notification toggle.
# VAPID_EMAIL is the bare contact email Google/Mozilla push services use if
# they need to reach you about abuse. The server prepends mailto: at runtime.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Error Tracking – Sentry (Optional)
# ------------------------------------------------------------------------------

# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Build-time only: when all four are set, the build uploads sourcemaps to
# Sentry and tags the bundle with a git-SHA release identifier (via
# @sentry/vite-plugin and @sentry/esbuild-plugin). Omit any of them to skip
# upload — errors still report, just without symbolicated stack traces.
# These vars are consumed by vite.config.ts and script/build.ts only; they
# are not read at runtime and do not appear in server/env.ts.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_CLIENT=
# SENTRY_PROJECT_SERVER=

# ------------------------------------------------------------------------------
# RAG Configuration (Optional, has defaults)
# ------------------------------------------------------------------------------

# RAG_CHUNK_SIZE=600             # Characters per chunk for coaching material embeddings
# RAG_CHUNK_OVERLAP=100          # Character overlap between chunks

# ------------------------------------------------------------------------------
# Runtime (Optional, has defaults)
# ------------------------------------------------------------------------------

# NODE_ENV=development           # development | production | test
# PORT=5000
# LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal
# APP_INSTANCE_COUNT=1           # Declared replica count. Values >1 are supported with Postgres-backed shared rate limits/cache state.

# Controls Express "trust proxy" so req.ip does not derive from attacker-
# controlled X-Forwarded-For headers. Accepts "0" (off), "1" (one trusted
# hop — the default, correct for Railway / most PaaS), or "loopback" (only
# local reverse proxies). See CODEBASE_AUDIT.md §2.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------

# ALLOW_DEV_AUTH_BYPASS=true     # Skip auth for local dev (BLOCKED in production)

# EMOM rollout flag. Keep this aligned with the server-side
# EMOM_BUILDER_ENABLED flag for each deployment tier.
# Recommended: dev=true, staging=true, production=false until rollout.
# VITE_EMOM_BUILDER_ENABLED=false
# EMOM_BUILDER_ENABLED=false

# Nutrition tracking module (Phase 1). Gate both flags together per tier; the
# server 404s the whole /api/v1/nutrition surface when its flag is off.
# VITE_NUTRITION_ENABLED=false
# NUTRITION_ENABLED=false

# Nutrition search quality (optional; sensible defaults baked in).
# NUTRITION_FUZZY_ENABLED: pg_trgm typo/fuzzy arm of local search (default "true";
#   set "false" to disable as a kill switch or before migration 0074 has run).
# NUTRITION_SEMANTIC_ENABLED: semantic (embeddings) search + its backfill cron
#   (default "false"). Requires AI_FEATURES_ENABLED != "false" + GEMINI_API_KEY and
#   uses the pgvector pool (VECTOR_DATABASE_URL); leave off to keep search keyword-only.
# NUTRITION_FUZZY_ENABLED=true
# NUTRITION_SEMANTIC_ENABLED=false

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup).
# Optional — without it, food search degrades to locally-cached foods only.
# USDA_API_KEY=

# Edamam Food Database API — the active branded/packaged + UPC-barcode source,
# used ahead of USDA for search and ahead of Open Food Facts for barcode. Its
# nutrients come back per-100g, so the data maps in directly. Sign up at
# https://developer.edamam.com (Food Database API), then copy the app id + app key.
# Both must be set together (or both omitted). Optional: when unset, search/barcode
# degrade to USDA + Open Food Facts as before.
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=

# Spoonacular API key — NOTE: superseded by Edamam (above) as the active branded
# search/barcode source; retained for reference and no longer wired into search/
# barcode. Single key (no OAuth, no IP whitelisting); free tier at
# https://spoonacular.com/food-api.
# SPOONACULAR_API_KEY=

# FatSecret Platform API — verified branded foods + barcode. NOTE: superseded (by
# Edamam) as the active branded search/barcode source; these settings are retained
# for reference and are no longer wired into search/barcode.
# OAuth2 client-credentials: create an app at https://platform.fatsecret.com and
# copy the Client ID / Secret. Both must be set together (or both omitted).
# Optional — without them, search/barcode work via USDA + Open Food Facts as before.
#
# ⚠️ IP WHITELISTING (deployment prerequisite): FatSecret rejects token/API
#    requests from non-whitelisted source IPs. Add this deployment's outbound
#    (egress) IP — up to 15 IPs/CIDRs — in the FatSecret dashboard, or every call
#    401s and the app silently falls back to USDA/OFF. On a PaaS with dynamic
#    egress IPs you may need a static-egress/NAT add-on.
# Tiers: Basic = US dataset, 5,000 calls/day, no barcode scope. Premier (incl. the
#    free Premier tier for startups/non-profits) = 56 countries + the `barcode`
#    scope + unlimited calls. Barcode lookup needs a barcode-enabled tier/scope.
# Attribution: FatSecret's terms require visible "Powered by FatSecret" attribution
#    on some tiers — surface it in the UI where FatSecret-sourced foods are shown.
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
# Space-delimited OAuth scopes (default "basic"). The app adapts to the scope:
#   "basic"   -> v1 foods.search (macros parsed from the result text; no barcode)
#   "premier" -> v3 foods.search (structured macros + micros); "barcode" -> scans.
# Premier example:
# FATSECRET_SCOPE=basic premier barcode localization
# Optional localization (localization-enabled scope/tier only):
# FATSECRET_REGION=
# FATSECRET_LANGUAGE=
