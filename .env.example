# ==============================================================================
# fitai.coach - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults or enable extra features.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core (Required)
# ------------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/fitaicoach"

# [OPTIONAL] Separate PostgreSQL/pgvector connection used by the RAG ingest +
# retrieval pipeline. When unset, the main DATABASE_URL is reused. Production
# splits this onto a Neon pgvector database; local dev can leave it blank.
# VECTOR_DATABASE_URL="postgresql://user:password@localhost:5432/fitaicoach_vector"

# [REQUIRED] Key for encrypting tokens at rest (AES-256-GCM): at least 32
# characters. A 64-character hex string is used as the key directly; anything
# else is SHA-256 hashed into one.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# [OPTIONAL] Rotation key for ENCRYPTION_KEY (W6). To rotate without downtime:
# set this to a fresh key (leave ENCRYPTION_KEY in place). New ciphertext is
# tagged `v2` and encrypted with this key, while the old key keeps decrypting
# existing data. Then set ENCRYPTION_REENCRYPT_ON_BOOT=true and redeploy once to
# migrate stored credentials forward. Must differ from ENCRYPTION_KEY/CSRF_SECRET.
ENCRYPTION_KEY_V2=

# [OPTIONAL] When "true" (and ENCRYPTION_KEY_V2 is set), re-encrypt all stored
# Strava/Garmin credentials to the active key version on boot. Defaults "false".
ENCRYPTION_REENCRYPT_ON_BOOT=false

# [REQUIRED IN PRODUCTION] Key for CSRF protection (at least 32 characters).
# In production this MUST be set. Whenever it is set, in any environment, it
# MUST differ from ENCRYPTION_KEY — both are enforced at startup. In
# development/test it may be omitted and the middleware generates a random
# per-process fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=

# [OPTIONAL] Comma-separated list of extra origins allowed by CORS. Localhost
# (ports 5000 and 5173) is permitted outside production; APP_URL and
# https://fitai.coach always are. Only needed when the frontend runs on a different host
# from the API (e.g. a staging domain calling prod).
# ALLOWED_ORIGINS="https://app.example.com,https://staging.example.com"

# ------------------------------------------------------------------------------
# Authentication – Clerk (Optional in development; required in production)
# ------------------------------------------------------------------------------
# Create a free project at https://dashboard.clerk.com
# Without both server keys the server only becomes ready with the dev auth
# bypass on (ALLOW_DEV_AUTH_BYPASS, below), which is refused in production.

# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# AI - Text provider + Gemini embeddings/vision (Optional)
# ------------------------------------------------------------------------------
# Text AI defaults to Gemini for backwards compatibility. Set
# AI_TEXT_PROVIDER=anthropic or AI_TEXT_PROVIDER=openai-compatible to route
# chat, text parsing, coach suggestions, review notes, and plan generation
# through another provider. RAG and food-search embeddings, photo-to-workout
# parsing, and nutrition photo and label parsing still use Gemini in this release.

# AI_TEXT_PROVIDER=gemini                 # gemini | anthropic | openai-compatible
# AI_TEXT_MODEL=                          # generic model override, any provider (Gemini falls back to GEMINI_MODEL / GEMINI_SUGGESTIONS_MODEL)
# AI_TEXT_FAST_MODEL=                     # optional fast parser model override
# AI_TEXT_REASONING_MODEL=                # optional coaching/planning model override
# AI_TEXT_REASONING_EFFORT=high           # none | low | medium | high
# AI_CHAT_REASONING_EFFORT=               # chat replies only; unset = lower of the above and medium
# AI_CHAT_TOOLS=false                     # coach chat function calling (read tools, plan-change tool); off until evaluated
# AI_TEXT_API_KEY=                        # generic key for anthropic/openai-compatible; when set it wins over the provider-specific keys

# AI_TEXT_OPENAI_COMPATIBLE_PROFILE=openai # openai | xai | groq | together | openrouter | deepseek | custom
# AI_TEXT_BASE_URL=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ANTHROPIC_API_KEY=

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_SUGGESTIONS_MODEL=gemini-3.1-pro-preview
# GEMINI_VISION_MODEL=gemini-2.5-flash

# Runtime kill switch for ALL AI routes — chat, parsing, plan generation, RAG,
# coach suggestions (default "true"). Set "false" to stop AI provider traffic
# without redeploying or rotating keys. Enforced in server/middleware/aibudget.ts.
# NUTRITION_SEMANTIC_ENABLED also requires this to be anything but "false".
# AI_FEATURES_ENABLED=true
#
# Application-wide AI spend ceiling, in cents, over a rolling 24h window across
# ALL users. The per-user cap ($2/day) bounds a single athlete but not the total
# bill, which otherwise scales with sign-ups. When reached, every AI route
# returns 503 AI_GLOBAL_BUDGET_EXCEEDED until spend ages out of the window.
# Unset = no global ceiling (per-user cap only) + a startup warning in prod.
# Example: 5000 = $50/day.
# AI_GLOBAL_DAILY_LIMIT_CENTS=5000

# ------------------------------------------------------------------------------
# Strava Integration (Optional, enables activity sync)
# ------------------------------------------------------------------------------

# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_STATE_SECRET=           # Signs OAuth state. Required in production when STRAVA_CLIENT_ID is set; random per process otherwise
# APP_URL=http://localhost:5000  # Used for OAuth + webhook callback URLs (webhooks need public https)
# Automatic sync (docs/integrations.md#automatic-sync). All optional.
# STRAVA_AUTO_SYNC_ENABLED=true          # false = manual Sync button only
# STRAVA_AUTO_SYNC_INTERVAL_MINUTES=60   # polling-fallback cadence per athlete (min 5)
# STRAVA_WEBHOOKS_ENABLED=true           # false = never register the push subscription
# STRAVA_WEBHOOK_VERIFY_TOKEN=           # derived from the client secret if omitted

# ------------------------------------------------------------------------------
# Garmin Connect Integration
# ------------------------------------------------------------------------------
# Garmin has no public OAuth app flow — the integration authenticates as the
# end user with their own email+password against Garmin's SSO via the
# @flow-js/garmin-connect library. Credentials are stored encrypted in the
# garmin_connections table. There is NO server-side Garmin client/secret to
# configure here, and the feature is always available when a user enables it
# in Settings. See docs/integrations.md#garmin-connect-integration.

# ------------------------------------------------------------------------------
# Email – Resend (Optional, enables weekly summaries & reminders)
# ------------------------------------------------------------------------------

# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=fitai.coach <Timmy@fitai.coach>

# ------------------------------------------------------------------------------
# Cron Jobs (Optional)
# ------------------------------------------------------------------------------

# CRON_SECRET=                   # Auth token for /api/v1/cron/emails endpoint
# INTERNAL_ANALYTICS_SECRET=     # Auth token for /api/v1/analytics/internal/* endpoints

# ------------------------------------------------------------------------------
# Web Push / VAPID (Optional, enables PWA push notifications)
# ------------------------------------------------------------------------------
# Generate a keypair with:
#   npx web-push generate-vapid-keys
# When any of these are unset, GET /api/v1/push/vapid-key returns 404
# PUSH_NOT_CONFIGURED, so browser push cannot be switched on, and sends skip
# browser subscriptions. Native app push (FCM_SERVICE_ACCOUNT_JSON) is separate.
# VAPID_EMAIL is the bare contact email Google/Mozilla push services use if
# they need to reach you about abuse. The server prepends mailto: at runtime.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=you@example.com

# ------------------------------------------------------------------------------
# Native Mobile App (Optional)
# ------------------------------------------------------------------------------
# Push to the native app goes through Firebase Cloud Messaging. Paste the
# Firebase service account key file whole, as JSON (Firebase console →
# Project settings → Service accounts). Server-only secret. Unset, native
# push is off and POST /api/v1/push/devices returns 404 PUSH_NOT_CONFIGURED.

# FCM_SERVICE_ACCOUNT_JSON=

# Oldest app build the API still serves, per platform, as MAJOR.MINOR.PATCH.
# Older builds get 426 APP_UPDATE_REQUIRED. Unset means every build is served.

# MIN_APP_VERSION_ANDROID=1.0.0
# MIN_APP_VERSION_IOS=1.0.0

# Android App Links: the app's package name and the SHA-256 fingerprints
# (comma-separated, AA:BB:… form) of its Play app-signing and upload
# certificates. Set both or neither; both unset means
# /.well-known/assetlinks.json is a 404.

# ANDROID_APP_PACKAGE=com.fitai.coach
# ANDROID_APP_CERT_SHA256=

# ------------------------------------------------------------------------------
# Error Tracking – Sentry (Optional)
# ------------------------------------------------------------------------------

# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Build-time only: when all four are set, the build uploads sourcemaps to
# Sentry and tags the bundle with a git-SHA release identifier (via
# @sentry/vite-plugin and @sentry/esbuild-plugin). Both plugins are disabled
# when SENTRY_AUTH_TOKEN is unset, which skips the upload — errors still
# report, just without symbolicated stack traces.
# These vars are consumed by vite.config.ts and script/build.ts only; they
# are not read at runtime and do not appear in server/env.ts.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_CLIENT=
# SENTRY_PROJECT_SERVER=

# ------------------------------------------------------------------------------
# RAG Configuration (Optional, has defaults)
# ------------------------------------------------------------------------------

# RAG_CHUNK_SIZE=600             # Characters per chunk for coaching material embeddings (whole number > 0)
# RAG_CHUNK_OVERLAP=100          # Character overlap between chunks (0 to RAG_CHUNK_SIZE - 1)
# RAG_MAX_COSINE_DISTANCE=0.6    # Drop retrieved chunks further than this cosine distance (0 to 2) from the query

# ------------------------------------------------------------------------------
# Runtime (Optional, has defaults)
# ------------------------------------------------------------------------------

# NODE_ENV=development           # development | production | test
# PORT=5000
# LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal | silent
# APP_INSTANCE_COUNT=1           # Declared replica count. Validated but not read by any code: the Postgres-backed shared rate limits/cache state is always on.

# Controls Express "trust proxy" so req.ip does not derive from attacker-
# controlled X-Forwarded-For headers. Accepts "0" (off), "1" (one trusted
# hop — the default, correct for Railway / most PaaS), or "loopback" (only
# local reverse proxies). See CODEBASE_AUDIT.md §2.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# Development Only
# ------------------------------------------------------------------------------

# ALLOW_DEV_AUTH_BYPASS=true     # Skip auth for local dev (BLOCKED in production)

# EMOM rollout flag. Keep this aligned with the server-side
# EMOM_BUILDER_ENABLED flag for each deployment tier.
# Recommended: dev=true, staging=true, production=false until rollout.
# VITE_EMOM_BUILDER_ENABLED=false
# EMOM_BUILDER_ENABLED=false

# Nutrition tracking module (Phase 1). Gate both flags together per tier; the
# server 404s the whole /api/v1/nutrition surface when its flag is off.
# VITE_NUTRITION_ENABLED=false
# NUTRITION_ENABLED=false

# Nutrition search quality (optional; sensible defaults baked in).
# NUTRITION_FUZZY_ENABLED: pg_trgm typo/fuzzy arm of local search (default "true";
#   set "false" to disable as a kill switch or before migration 0074 has run).
# NUTRITION_SEMANTIC_ENABLED: semantic (embeddings) search + its backfill cron
#   (default "false"). Requires AI_FEATURES_ENABLED != "false" + GEMINI_API_KEY and
#   uses the pgvector pool (VECTOR_DATABASE_URL); leave off to keep search keyword-only.
# NUTRITION_FUZZY_ENABLED=true
# NUTRITION_SEMANTIC_ENABLED=false

# Structured-blocks workout write path (server/routes/structuredWriteGuard.ts).
# STRUCTURED_BLOCKS_ENABLED: the write guard (default "true") — a workout saved
#   with text but no exercise rows or structure blocks is refused with 422.
# STRUCTURED_BLOCKS_FALLBACK_FORCE_LEGACY: escape hatch — when "true", forces the
#   legacy write path even if STRUCTURED_BLOCKS_ENABLED is "true" (default "false").
# STRUCTURED_BLOCKS_ENABLED=true
# STRUCTURED_BLOCKS_FALLBACK_FORCE_LEGACY=false

# USDA FoodData Central API key (free: https://fdc.nal.usda.gov/api-key-signup).
# Optional — without it, USDA is skipped; food search still uses the local
# cache, Edamam (when configured) and Open Food Facts.
# USDA_API_KEY=

# Edamam Food Database API — the active branded/packaged + UPC-barcode source,
# used ahead of USDA for search and ahead of Open Food Facts for barcode. Its
# nutrients come back per-100g, so the data maps in directly. Sign up at
# https://developer.edamam.com (Food Database API), then copy the app id + app key.
# Both must be set together (or both omitted). Optional: when unset, search/barcode
# degrade to USDA + Open Food Facts as before.
# EDAMAM_APP_ID=
# EDAMAM_APP_KEY=

