<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a local server over plain HTTP. Release builds keep the default, HTTPS-only policy. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as the emulator sees it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- A device using adb reverse. -->
        <domain includeSubdomains="false">localhost</domain> <!-- DevSkim: ignore DS162092 -->
    </domain-config>
</network-security-config>
