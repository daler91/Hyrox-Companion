<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or carried to a new device (Android 12+; allowBackup
     is false for older versions). The device holds a signed-in session, the
     athlete's own database with unsent changes, and push and Health Connect
     state for that account; a restore on another device or after reinstall
     would hand them to whoever signs in there. The account syncs from the
     server instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
